# Public build-time settings (VITE_* values ship to the browser; never put secrets here).
# The Arcade API key lives only in the Next.js app at the repo root.

# COMO Next.js API. Use http://localhost:3000 when running `npm run dev` at the repo root.
VITE_COMO_API_URL=https://como-puce.vercel.app

# "true" uses bundled sample art and makes no Arcade calls.
VITE_ARCADE_MOCK=false

# Ideas per "Generate" click, 1-4. Each one is a separate paid Arcade generation.
VITE_IDEAS_PER_BATCH=4
